ISM-FJ interface 1
# Soft Flight Lab / HIL bay I/O channel map (#88)
# Study-scale board: fighter-jet/kicad/ism-fighter-jet
# Pin/header map frozen enough for Soft avionics-check (Rev A stub)
# Stores/SMS: SAFE/INHIBIT integration only — no arming or live launch
# provisional: true

iface_id: bay-io
vehicle_id: ISM-FJ-1
revision: A
status: stub
issue: 88
related_issues: 84,119,80
mcu: RP2040
kicad_project: fighter-jet/kicad/ism-fighter-jet
firmware: fighter-jet/firmware/
params: fighter-jet/parameters/ism-fj-1.ismfj-params
bit_frame: fighter-jet/interfaces/bit-frame.yaml
safe_state: fighter-jet/interfaces/safe-state.yaml

# --- Soft channel map (header Jx / trunk Ax) ---
channel act_aileron: header J1 trunk A1
channel act_elevator: header J2 trunk A2
channel act_rudder: header J3 trunk A3
channel act_throttle: header J4 trunk A4
channel disc_radio_enable: header J1 net RADIO_EN_stub
channel disc_imu_sample_gate: header J2 net IMU_GATE_stub

# --- Inceptors (uplink / host substitute) ---
channel inc_stick_pitch: kind inceptor range -1.0..1.0
channel inc_stick_roll: kind inceptor range -1.0..1.0
channel inc_throttle: kind inceptor range -1.0..1.0
channel inc_pedal_yaw: kind inceptor range -1.0..1.0
channel uplink_valid: kind discrete_in
channel imu_data: kind sensor_stream bus I2C_IMU

# --- Buses ---
bus I2C_IMU: nets I2C_SDA,I2C_SCL peers U2_IMU
bus SPI_RADIO: nets SPI_SCK,SPI_MOSI,SPI_MISO peers U3_RADIO
bus ISM_Bus_A_stub: role uplink_from_FCC_MC host_substitute uart_stdio

# --- Power / rails ---
rail board_3v3: present
rail board_5v: present
rail board_gnd: present
note aircraft_28v_essential: upstream_of_bay_pdu

# --- Debug ---
debug SWD_stub: present
debug UART_stdio_host_profile: present
debug USB_dev_optional: present

# --- Stores integration boundary (Soft) ---
stores_policy: inert_integration_only
sms_force_safe: see fighter-jet/interfaces/sms-interface.yaml
safe_inhibit_table: fighter-jet/interfaces/safe-inhibit-table.yaml
no_seekers: true
no_guidance: true
no_warheads: true
no_fuzing: true
no_live_launch: true

# YAML companions with richer structure remain under fighter-jet/interfaces/
# (firmware-bringup.yaml, bit-frame.yaml, safe-state.yaml, hardpoints.yaml).
